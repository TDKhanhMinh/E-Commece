            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientName\": \"John Doe Updated\",\n  \"phone\": \"0987654321\",\n  \"address\": \"456 New Street\",\n  \"ward\": \"Ward 2\",\n  \"district\": \"District 2\",\n  \"city\": \"Ha Noi\",\n  \"isDefault\": false\n}"
